#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 VERSION" >&2
    exit 2
fi

version=$1
case "$version" in
    ''|[!0-9]*|*[!0-9.+~:-]*)
        echo "Invalid Debian package version: $version" >&2
        exit 2
        ;;
esac

command -v dpkg-deb >/dev/null 2>&1 || {
    echo "dpkg-deb is required to build the Debian package" >&2
    exit 1
}

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
output_dir=$repo_root
staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT HUP INT TERM
package_root=$staging/cockpit-caddy

mkdir -p "$package_root/DEBIAN"
NODE_ENV=production make -C "$repo_root" DESTDIR="$package_root" PREFIX=/usr install

cat > "$package_root/DEBIAN/control" <<EOF
Package: cockpit-caddy
Version: $version
Section: admin
Priority: optional
Architecture: all
Depends: cockpit-bridge
Maintainer: Cockpit Caddy contributors <noreply@github.com>
Homepage: https://github.com/Gustiana882/cockpit-caddy
Description: Caddy reverse proxy management for Cockpit
 Manage Caddy reverse proxy and static site routes from the Cockpit interface.
EOF

dpkg-deb --build --root-owner-group "$package_root" "$output_dir/cockpit-caddy_${version}_all.deb"
echo "Created $output_dir/cockpit-caddy_${version}_all.deb"
