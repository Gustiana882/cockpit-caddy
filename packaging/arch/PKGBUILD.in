pkgname=cockpit-caddy
pkgver=VERSION
pkgrel=1
pkgdesc='Caddy reverse proxy management for Cockpit'
arch=('x86_64')
url='https://github.com/Gustiana882/cockpit-caddy'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
